font-family = FiraCode Nerd Font
theme = light:Github Light Default,dark:GitHub Dark Default
background-opacity = 0.95
# background-blur = true
unfocused-split-opacity = 0.95
# scrollback-limit = 50000
title = " "
window-padding-balance = true
window-decoration = auto
window-height = 48
window-width = 161
window-save-state = always
clipboard-write = allow
quit-after-last-window-closed = true
macos-titlebar-style = tabs
macos-titlebar-proxy-icon = hidden
macos-option-as-alt = true

keybind = ctrl+_=new_split:down
keybind = ctrl+|=new_split:right

keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+j=goto_split:down
keybind = ctrl+shift+k=goto_split:up
keybind = ctrl+shift+l=goto_split:right

keybind = ctrl+alt+h=resize_split:left,10
keybind = ctrl+alt+j=resize_split:down,10
keybind = ctrl+alt+k=resize_split:up,10
keybind = ctrl+alt+l=resize_split:right,10

keybind = ctrl+alt+z=toggle_split_zoom

keybind = shift+enter=text:\x1b\r

keybind = global:cmd+grave_accent=toggle_quick_terminal

# command = /bin/bash -c "exec /opt/homebrew/bin/tmux -f \"$HOME/.config/tmux/tmux.conf\""
